# Copy to .env — .env is gitignored and must stay so.
# NEVER put real credentials in THIS file: it is committed to git.

# fake (default) never touches Telnyx. Set to "real" only deliberately,
# with a human at the keyboard (SD-13 guardrail is deferred; this default
# is the interim protection).
TELNYX_MODE=fake

# Required only when TELNYX_MODE=real.
TELNYX_API_KEY=
# The account's Ed25519 public key (base64) from the Telnyx portal,
# used to verify webhook signatures (FR-NF-5).
TELNYX_PUBLIC_KEY=
